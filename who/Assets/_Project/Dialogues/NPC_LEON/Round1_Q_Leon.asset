  m_Script: {fileID: 11500000, guid: 7ec67372583111449a48e50ad523632c, type: 3}
  m_Name: Round1_Q_Leon
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  mode: 0
  lines:
  - "Yo solo hago lo m\xEDo. Bailo si quiero, hablo si quiero. Y no me interesa que
    a alguien le parezca exagerado."
  - "No me gusta que me cuestionen. Y s\xED, noto que usted me observa. Bien\u2026
    pero tenga cuidado, no todos reaccionan igual a la curiosidad ajena."
