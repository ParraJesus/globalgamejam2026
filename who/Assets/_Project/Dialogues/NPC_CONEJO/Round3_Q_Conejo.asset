  m_Script: {fileID: 11500000, guid: 7ec67372583111449a48e50ad523632c, type: 3}
  m_Name: Round3_Q_Conejo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  mode: 0
  lines:
  - "\xA1Ay! Cuando se apag\xF3 la luz me asust\xE9 much\xEDsimo y me qued\xE9 quieta.
    No pod\xEDa moverme de miedo."
  - "Escuch\xE9 algo caer, fue un golpe bastante fuerte, \xA1Ay!, estoy segura de
    que todos en la oscuridad lo escucharon."
