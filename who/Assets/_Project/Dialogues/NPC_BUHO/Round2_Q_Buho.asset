  m_Script: {fileID: 11500000, guid: 7ec67372583111449a48e50ad523632c, type: 3}
  m_Name: Round2_Q_Buho
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  mode: 0
  lines:
  - "Siempre estuve al lado de la chica con m\xE1scara de zorro. No me separ\xE9
    de ella ni un segundo, as\xED que no puedo decir qu\xE9 pas\xF3 lejos de nosotros."
  - "El chico con m\xE1scara de le\xF3n y el que estaba junto a la barra nunca estuvieron
    en un grupo hablando, al menos no mientras yo miraba."
