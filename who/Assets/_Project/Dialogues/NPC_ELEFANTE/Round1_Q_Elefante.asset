  m_Script: {fileID: 11500000, guid: 7ec67372583111449a48e50ad523632c, type: 3}
  m_Name: Round1_Q_Elefante
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  mode: 0
  lines:
  - "Vi al chico junto a la barra antes de que se apagaran las luces. Parec\xEDa
    que estaba solo por un momento, nadie se acercaba demasiado."
  - "La chica con m\xE1scara de zorro estaba cerca de la barra, hablando con alguien,
    no me acerqu\xE9 para interrumpir\u2026 Me est\xE1 asustando todo esto, \xBFPor
    qu\xE9 nadie puede abrir la puerta?."
