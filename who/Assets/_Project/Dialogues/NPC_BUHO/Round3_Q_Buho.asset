  m_Script: {fileID: 11500000, guid: 7ec67372583111449a48e50ad523632c, type: 3}
  m_Name: Round3_Q_Buho
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  mode: 0
  lines:
  - "Cuando se apag\xF3 la luz, bueno... me asust\xE9 como todos. Me qued\xE9 quieta
    con los dem\xE1s, todos estamos algo asustados despu\xE9s de todo."
  - "Escuch\xE9 un sonido fuerte en alg\xFAn momento. No s\xE9 qu\xE9 fue, pero fue
    contundente."
