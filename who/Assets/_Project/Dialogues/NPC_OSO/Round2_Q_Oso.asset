  m_Script: {fileID: 11500000, guid: 7ec67372583111449a48e50ad523632c, type: 3}
  m_Name: Round2_Q_Oso
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  mode: 0
  lines:
  - "Parece que es el sujeto que viene a ayudarme, no le dir\xE9 mucho, pero te lo
    dejar\xE9 de consejo para esta noche. He aprendido que los que siempre se rodean
    de gente son los m\xE1s peligrosos, as\xED que ten cuidado con ellos."
